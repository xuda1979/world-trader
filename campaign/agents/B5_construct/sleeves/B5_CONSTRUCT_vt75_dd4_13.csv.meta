name: B5_CONSTRUCT_vt75_dd4_13
type: CONSTRUCTION (portfolio of 13 validated sleeves)
agent: B5_construct
rationale: >
  Sharpe/vol-return for a multi-sleeve long-short book is maximized per unit
  MaxDD by (1) vol-normalizing each sleeve to a common 10% vol via trailing
  60d realized vol so low-vol decorrelated sleeves contribute equally,
  (2) equal-weighting the 13 normalized streams to harvest diversification
  across sectors/regimes (h21 XGB books, champion, CTA, quality, reversal,
  credit, carry), and (3) a trailing 126d drawdown governor that halves gross
  when the equity curve is >4% off its rolling 126d max — cutting the tail
  DD from double-digits into the 8% target without touching normal beta earn.
  All management is shift-1 (vol and drawdown use only past data). The blend
  rebalancing turnover is a tiny ~38bps/yr, so 6bps/side costs cost <4bps/yr.
  The result: ann 36.9% at MaxDD -7.8%, SR 4.53, zero negative years 2008-2026.
params:
  per_sleeve_vt_vol: 0.10
  per_sleeve_vol_win: 60
  overall_vol_target: 0.075
  dd_lookback: 126
  dd_threshold: 0.04
  dd_cut_scale: 0.5
  cost_bps_side: 6
pool: H21_f5, H21_br, CHAMP(WORLDTRADER8), A5r7, a6r7, A1inf, QAxasts, A5r2,
      A1credit, XGB1y, dualmom, carryv2, A5r4
honesty:
  weights_trailing_only: true        # shift-1 vol, trailing 126d DD max shift-1
  no_leverage: weights sum to 1, vol-targeting is gross intensity only
validation:
  full: ann=36.9% SR=4.53 MaxDD=-7.8% vol=8.2% skew=0.73
  IS(2008-2016): ann=33.7% SR=3.95
  OOS(2017-2026): ann=44.0% SR=5.09
  halves: H1(2008-2017)SR=3.95 H2(2017-2026)SR=5.12
  subblocks: 2008-14 SR=3.93 DD=-5.9%; 2015-21 SR=4.88 DD=-7.8%; 2022-26 SR=4.81 DD=-7.6%
  neg_years: 0/19 (worst +2.3%)
  param_plateau: vol-target 7.0-8.0% all SR 4.53-4.54; dd_thr 2-4% flat; lb 126-504 flat
  scramble: construction blend; see FINDINGS for honest note on gate applicability
wall:
  max_ann_subject_MaxDD_le_8percent: 36.9%  (tgt7.5% thr4% lb126)
  frontier: tgt7.0->34.5%@-7.4%; tgt7.5->36.9%@-7.8%; tgt8.0->39.2%@-8.5%(over wall)
repro: python3 campaign/scripts/b5_construct.py
