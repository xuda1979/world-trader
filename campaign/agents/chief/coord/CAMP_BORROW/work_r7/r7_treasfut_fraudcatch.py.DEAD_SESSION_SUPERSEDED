    out["plateau_csv_byte_identity"] = byteid

    # DEFECT-#2 plateau numbers from MY double-net rebuild at TRUE k
    plat = {}
    for name, t, kind, sign, primary, k in BOOKS:
        if k == 5:
            continue
        W, R = build_book(t, kind, sign, k=k)
