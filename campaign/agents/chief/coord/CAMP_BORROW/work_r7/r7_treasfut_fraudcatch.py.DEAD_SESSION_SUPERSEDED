def sha16(p):
    return hashlib.sha256(open(p, "rb").read()).hexdigest()[:16]


# ---------------------------------------------------------------- my own loaders
def load_yield(sid):
    """FRED CMT yield (PERCENT) -> DECIMAL, sort+dedup-index assert."""
    s = pd.read_csv(f"{FRED}/{sid}.csv", index_col=0, parse_dates=True)["value"].astype(float)
    assert s.index.is_monotonic_increasing and not s.index.duplicated().any()
    return (s / 100.0).sort_index()


def synth_tr(y, dur):
    """Campaign synth-TR convention: TR_t = -dur * dy + y_{t-1}/252 (decimal)."""
    return -dur * y.diff() + y.shift(1) / 252.0


def grid(tenor, dur):
    R = synth_tr(load_yield(f"DGS{tenor}"), dur).dropna().to_frame(tenor)
    v = R[tenor].std() * np.sqrt(252)
    assert 0.01 <= v <= 0.30, f"units guard {tenor}y: ann vol {v:.3f}"
    return R


def load_auctions():
    """Tidy tauctions.csv -> wide btc frame on the four flagship fresh-issue terms.
    Dedup rule (disclosed in their meta): keep LARGEST total_accepted_mmn per (date,term)."""
    raw = pd.read_csv(TA, parse_dates=["date"])
    terms = {"2": ("Note", "2-Year"), "5": ("Note", "5-Year"),
             "10": ("Note", "10-Year"), "30": ("Bond", "30-Year")}
    keep = []
    for t, (typ, term) in terms.items():
        s = raw[(raw["type"] == typ) & (raw["term"] == term)].copy()
        s = (s.sort_values("total_accepted_mmn", ascending=False)
             .drop_duplicates(subset=["date"], keep="first").sort_values("date"))
        keep.append(pd.Series(s["bid_to_cover"].values, index=s["date"].values, name=t))
    ev = pd.concat(keep, axis=1).sort_index()
    ev.index = pd.DatetimeIndex(ev.index)
    ev.index.name = "date"
    return ev


def expanding_median_past(s, min_prior=MIN_PRIOR):
    """PIT convention (A): median of STRICTLY PRIOR non-NaN values; NaN until min_prior."""
    v = s.sort_index().values.astype(float)
    out = np.full(len(v), np.nan)
    for i in range(1, len(v)):
        past = v[:i][np.isfinite(v[:i])]
        if len(past) >= min_prior:
            out[i] = float(np.median(past))
    return pd.Series(out, index=s.sort_index().index)


# ---------------------------------------------------------------- my own engine
def net_of(W, R, vt=True, target=0.10):
    """T+1, vt10 expanding clip3, 6.4bps full |dW| incl entry, 0.5%/yr borrow on shorts."""
    W = W.reindex(index=R.index, columns=R.columns).fillna(0.0)
    We = W.shift(1).fillna(0.0)
    gross = (We * R).sum(axis=1)
    if vt:
        vols = gross.expanding(min_periods=60).std(ddof=1) * np.sqrt(252)
        scale = (target / vols.replace(0.0, np.nan)).clip(upper=3.0).clip(lower=0.2)
        scale = scale.shift(1).fillna(1.0)
        We = We.mul(scale, axis=0)
    port = (We * R).sum(axis=1)
    prev = We.shift(1)
    prev.iloc[0] = 0.0
    cost = (We - prev).abs().sum(axis=1) * COST_BPS / 1e4
    borrow = (-We.clip(upper=0.0)).sum(axis=1) * 0.005 / 252.0
    return (port - cost - borrow).rename("ret"), We


def build_book(tenor, kind, sign, k):
    """My own window construction. post: rows [e+1, e+k]; pre: rows [e-k, e-1];
    later windows overwrite (mask semantics). cond: surprise sign * window."""
    R = grid(tenor, DURS[tenor])
    idx = R.index
    pos = pd.Series(np.arange(len(idx)), index=idx)
    if kind == "cond":
        ev = load_auctions()[tenor].dropna()
        med = expanding_median_past(ev)
        surp = (ev - med).dropna()
        w = pd.Series(0.0, index=idx)
        for e, s in surp.items():
            i = pos.asof(e)
            if pd.isna(i):
                continue
            i = int(i)
            if i >= len(idx):
                continue
            v = float(sign) * float(np.sign(s))
            lo, hi = i + 1, min(i + k, len(idx) - 1)
            if hi >= lo:
                w.iloc[lo:hi + 1] = v
    else:
        ev = load_auctions().index[load_auctions()[tenor].notna()]
        ipos = np.searchsorted(idx.values, ev.values)
        w = pd.Series(0.0, index=idx)
        for e in ipos:
            if e >= len(idx):
                continue
            if kind == "post":
                lo, hi = e + 1, min(e + k, len(idx) - 1)
            else:
                lo, hi = max(e - k, 0), e - 1
            if hi >= lo:
                w.iloc[lo:hi + 1] = float(sign)
    return pd.DataFrame({tenor: w}), R


def per_unit_feed(R, We):
    """Their disclosed battery-feed convention (the DEFECT-#1 surface): net_of called AGAIN
    on the already-effective weights = a second shift(1)+VT+cost pass. I reconstruct it
    my way: We -> W2 = We.shift(-0) ... no: their per_unit_feed calls net_of(We, R) where
    We are the effective weights. net_of shifts them AGAIN. So the double book is
    net_of(We)['net'] with its own first_live trim."""
    net2, We2 = net_of(We, R)
    first = (We2.fillna(0.0) != 0).any(axis=1)
    if not first.any():
        raise ValueError("dead book")
    first_live = first.idxmax()
    net2 = net2[net2.index >= first_live]
    We2 = We2.reindex(net2.index).fillna(0.0)
    sig = We2.sum(axis=1)
    Rf = R.reindex(net2.index).fillna(0.0)
    port = (We2 * Rf).sum(axis=1)
    prev = We2.shift(1)
    prev.iloc[0] = 0.0
    cost = (We2 - prev).abs().sum(axis=1) * COST_BPS / 1e4
    borrow = (-We2.clip(upper=0.0)).sum(axis=1) * 0.005 / 252.0
    raw = port - cost - borrow
    r_pu = (raw / sig.replace(0.0, np.nan)).fillna(0.0)
    return r_pu, sig, net2


def welch_t(a, b):
    a, b = np.asarray(a, float), np.asarray(b, float)
    a, b = a[np.isfinite(a)], b[np.isfinite(b)]
    va, vb = a.var(ddof=1) / len(a), b.var(ddof=1) / len(b)
    return float((a.mean() - b.mean()) / np.sqrt(va + vb))


