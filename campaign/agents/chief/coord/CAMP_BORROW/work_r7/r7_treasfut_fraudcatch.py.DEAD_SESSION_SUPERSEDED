        ret = R[t]
        pos = pd.Series(np.arange(len(R)), index=R.index)
        e_t = ev[t].dropna()
        post5, allb = [], []
        for a in e_t.index:
            i = pos.asof(a)
            if pd.isna(i):
                continue
            i = int(i)
            lo, hi = i + 1, min(i + K, len(R) - 1)
            d5 = float(ret.iloc[lo:hi + 1].sum()) if hi >= lo else np.nan
            post5.append(d5)
        post5 = np.array([x for x in post5 if np.isfinite(x)])
        # all-days drift: 5-day forward synth-TR sum from EVERY grid day (the unconditional
        # comparison sample; overlapping is fine for the mean/Welch comparison)
        fwd5 = ret.rolling(K).sum().shift(-K + 1)  # sum of rows [i, i+4] ending window
        alld = fwd5.dropna().values
        allb = float(alld.mean() * 1e4)
        # weak/strong conditional on btc surprise sign
        med = expanding_median_past(e_t)
        surp = (e_t - med).dropna()
        dmap = {}
        idx = R.index
        posv = pos.values
        for a in e_t.index:
            i = pos.asof(a)
            if pd.isna(i):
                continue
            i = int(i)
            lo, hi = i + 1, min(i + K, len(R) - 1)
            if hi >= lo:
                dmap[a] = float(ret.iloc[lo:hi + 1].sum())
        dser = pd.Series(dmap)
        weak = dser.reindex(surp[surp < 0].index).dropna()
        strong = dser.reindex(surp[surp > 0].index).dropna()
        # Welch excess t: post-window sample vs all-days sample (mine, own formula)
        t_ex = welch_t(post5, alld)
        drift[t] = dict(
            post_bp=float(post5.mean() * 1e4),
            all_bp=allb,
            excess_bp=float(post5.mean() * 1e4 - allb),
            welch_t_excess=t_ex,
            weak_bp=float(weak.mean() * 1e4) if len(weak) else None,
            strong_bp=float(strong.mean() * 1e4) if len(strong) else None,
            n_post=len(post5),
