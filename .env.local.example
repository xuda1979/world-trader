# world-trader API keys -- copy to .env.local and fill in.
# .env.local is gitignored; NEVER commit real keys.
# All providers below have free tiers. The scanner degrades gracefully if a
# key is missing (see `python3 tools/scan.py --doctor`).

# FRED (St. Louis Fed) -- unlimited. Rates, yield curve, VIX, credit, macro.
#   get one: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_KEY=

# Finnhub -- 60 calls/min. Global equity/ADR quotes with intraday OHLC.
#   https://finnhub.io/register
FINNHUB_KEY=

# Twelve Data -- 800/day, 8/min. Real-time FX + indices.
#   https://twelvedata.com/pricing
TWELVEDATA_KEY=

# AlphaVantage -- ~25 calls/day, 5/min. Quotes, FX, movers, commodities.
#   https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_KEY=

# Polygon.io -- 5/min (stocks/ETF only on free; options Greeks need paid).
#   https://polygon.io/dashboard/signup
POLYGON_KEY=
