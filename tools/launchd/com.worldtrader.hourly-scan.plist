<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.worldtrader.hourly-scan</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/daxu/software/world-trader/tools/hourly_scan.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/daxu/software/world-trader</string>

    <!-- Run at minute 0 of every hour. launchd runs a missed event once after wake. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/daxu/software/world-trader/tools/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/daxu/software/world-trader/tools/logs/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>
</dict>
</plist>
